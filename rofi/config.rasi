/**
 * Rofi — Apple Spotlight / macOS Vibes
 * Ultra-translucent glass, zero noise, surgical spacing
 **/

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
    window-format: "{c} · {t}";
    font: "Inter 13";

    /* ✅ Só mostra resultados após digitar */
    show-match: false;
    lazy-grab: true;
    matching: "fuzzy";

    /* Começa sem nenhum resultado visível */
    drun-match-fields: "name,generic,exec,categories";
}

* {
    /* Glass palette — matched with bar design */
    bg-base: #14171f;
    bg-glass: #14171f8c; /* Qt.rgba(0.08, 0.09, 0.12, 0.55) */
    bg-hover: #ffffff14;
    bg-selected: #ffffff1a; /* Qt.rgba(1, 1, 1, 0.10) */
    
    fg-primary: #ffffffee;
    fg-secondary: #ffffff66;
    fg-placeholder: #ffffff33;
    accent: #0a84ff;
    
    border-subtle: #ffffff21; /* Qt.rgba(1, 1, 1, 0.13) */
    transparent: #00000000;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 600px; /* ligeiramente maior */

    margin: 0px;
    padding: 0px;
    border: 1px solid;
    border-radius: 14px;
    border-color: @border-subtle;
    background-color: @bg-glass;
    cursor: "default";
}

mainbox {
    spacing: 0px;
    padding: 0px;
    background-color: transparent;
    children: [ "inputbar", "listview"];
}

/* ── Search bar ── */
inputbar {
    spacing: 0px;
    padding: 18px 20px 16px 20px;
    border: 0px 0px 1px 0px;
    border-color: @border-subtle;
    background-color: transparent;
    text-color: @fg-primary;
    children: [ "prompt", "entry"];
}

prompt {
    enabled: true;
    padding: 0px 10px 0px 0px;
    background-color: transparent;
    text-color: @fg-secondary;
}

entry {
    background-color: transparent;
    text-color: @fg-primary;
    cursor: text;
    placeholder: "Spotlight Search";
    placeholder-color: @fg-placeholder;
}

/* ── Results ── */
listview {
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;

    spacing: 2px;
    padding: 10px 10px 10px 10px;
    background-color: transparent;
    text-color: @fg-primary;
    cursor: "default";
}

/* ── Item ── */
element {
    spacing: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @fg-primary;
    cursor: pointer;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color: @fg-primary;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @bg-selected;
    text-color: @fg-primary;
}

element-icon {
    background-color: transparent;
    size: 30px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/* ── Error ── */
error-message {
    padding: 40px;
    border: 1px solid;
    border-radius: 14px;
    border-color: @border-subtle;
    background-color: @bg-glass;
    text-color: @fg-primary;
}

textbox {
    background-color: transparent;
    text-color: @fg-secondary;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    highlight: none;
}