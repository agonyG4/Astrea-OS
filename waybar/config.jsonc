{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [
        "image",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "image#album-art",
        "mpris"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/control-center",
        "clock"
    ],
    "image": {
        "path": "/home/agony/.config/waybar/img/astrea.png",
        "size": 24,
        "on-click": "rofi -show drun"
    },
    "image#album-art": {
        "exec": "~/.config/waybar/scripts/album_art.sh",
        "size": 28,
        "interval": 3,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○",
            "urgent": "●"
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "all-outputs": false,
        "active-only": false,
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "mpris": {
        "format": "{player_icon}  {title} — {artist}",
        "format-paused": "⏸  {title} — {artist}",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "󰈹"
        },
        "max-length": 45
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid}  {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": " {device_alias}",
        "on-click": "python3 /home/agony/.config/waybar/scripts/bluetooth_popup.py"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "on-click": "python3 /home/agony/.config/waybar/scripts/volume_popup.py",
        "tooltip-format": "Volume: {volume}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󱐋",
        "format-plugged": "",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{capacity}%  •  {time}"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/control-center": {
        "format": "󰊲",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    },
    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    }
}