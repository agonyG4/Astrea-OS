{
    "_comment": "StorageSense — mapeamento completo do home. Ordem importa: primeira categoria que casar vence.",
    "games": {
        "label": "Games",
        "emoji": "🎮",
        "include_paths": [
            "~/Games",
            "~/Oblivion",
            "~/.local/share/Steam",
            "~/.local/share/PrismLauncher",
            "~/.local/share/ACCELA",
            "~/.local/share/Astrea",
            "~/.local/share/SLSsteam",
            "~/.local/share/Paradox Interactive",
            "~/.paradoxlauncher",
            "~/.var/app/com.valvesoftware.Steam",
            "~/.var/app/org.prismlauncher.PrismLauncher"
        ],
        "match_dirs": [
            "steamapps",
            "compatdata",
            "shadercache",
            "prismlauncher",
            "minecraft"
        ]
    },
    "cache": {
        "label": "Cache / Temp",
        "emoji": "🗑️",
        "include_paths": [
            "~/.cache",
            "~/.local/share/Trash"
        ]
    },
    "flatpak": {
        "label": "Flatpaks",
        "emoji": "📦",
        "include_paths": [
            "~/.var/app"
        ]
    },
    "spotify": {
        "label": "Spotify",
        "emoji": "🟢",
        "include_paths": [
            "~/.local/share/spotify-launcher"
        ]
    },
    "images": {
        "label": "Imagens",
        "emoji": "🖼️",
        "include_paths": [
            "~/Imagens",
            "~/Área de trabalho"
        ],
        "extensions": [
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".webp",
            ".bmp",
            ".tiff",
            ".tif",
            ".svg",
            ".ico",
            ".heic",
            ".heif",
            ".avif",
            ".raw",
            ".cr2",
            ".nef",
            ".arw",
            ".dng",
            ".psd",
            ".xcf",
            ".kra"
        ]
    },
    "videos": {
        "label": "Vídeos",
        "emoji": "🎬",
        "include_paths": [
            "~/Vídeos",
            "~/Área de trabalho"
        ],
        "extensions": [
            ".mp4",
            ".mkv",
            ".avi",
            ".mov",
            ".wmv",
            ".flv",
            ".webm",
            ".m4v",
            ".mpg",
            ".mpeg",
            ".ts",
            ".m2ts",
            ".vob",
            ".ogv",
            ".3gp",
            ".rmvb"
        ]
    },
    "music": {
        "label": "Músicas",
        "emoji": "🎵",
        "include_paths": [
            "~/Músicas"
        ],
        "extensions": [
            ".mp3",
            ".flac",
            ".ogg",
            ".opus",
            ".wav",
            ".aac",
            ".m4a",
            ".wma",
            ".alac",
            ".aiff",
            ".ape",
            ".mka",
            ".mid",
            ".midi"
        ]
    },
    "documents": {
        "label": "Documentos",
        "emoji": "📄",
        "include_paths": [
            "~/Documentos",
            "~/Área de trabalho"
        ],
        "extensions": [
            ".pdf",
            ".doc",
            ".docx",
            ".odt",
            ".rtf",
            ".txt",
            ".md",
            ".tex",
            ".xls",
            ".xlsx",
            ".ods",
            ".csv",
            ".ppt",
            ".pptx",
            ".odp",
            ".epub",
            ".mobi",
            ".djvu",
            ".pages",
            ".numbers",
            ".key"
        ]
    },
    "code": {
        "label": "Código / GitHub",
        "emoji": "💻",
        "include_paths": [
            "~/GitHub",
            "~/.rustup"
        ],
        "extensions": [
            ".py",
            ".js",
            ".ts",
            ".jsx",
            ".tsx",
            ".rs",
            ".go",
            ".c",
            ".cpp",
            ".h",
            ".hpp",
            ".java",
            ".kt",
            ".swift",
            ".rb",
            ".php",
            ".lua",
            ".sh",
            ".bash",
            ".zsh",
            ".fish",
            ".qml",
            ".json",
            ".toml",
            ".yaml",
            ".yml",
            ".xml",
            ".html",
            ".css",
            ".scss",
            ".sql",
            ".vue",
            ".svelte"
        ]
    },
    "config": {
        "label": "Configs",
        "emoji": "⚙️",
        "include_paths": [
            "~/.config",
            "~/.local/share/applications"
        ]
    },
    "apps": {
        "_comment": "Apps instalados no home que não são Flatpak nem config pura.",
        "label": "Apps (home)",
        "emoji": "📱",
        "include_paths": [
            "~/.antigravity",
            "~/.local/share/qmlls",
            "~/.local/share/easyeffects",
            "~/.local/share/kactivitymanagerd"
        ],
        "extensions": []
    },
    "downloads": {
        "_comment": "Pega TUDO em ~/Downloads que não foi classificado por outra categoria antes.",
        "label": "Downloads",
        "emoji": "⬇️",
        "include_paths": [
            "~/Downloads"
        ],
        "extensions": []
    }
}