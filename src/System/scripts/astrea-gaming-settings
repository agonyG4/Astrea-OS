#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


DEFAULT_GAMESCOPE = {
    "follow_monitor": True,
    "width": 1920,
    "height": 1080,
    "refresh": 165,
    "fullscreen": True,
    "steam_integration": True,
    "backend_drm": True,
    "immediate_flips": True,
    "hide_cursor": True,
    "fancy_scaling": True,
    "color_managed": True,
    "virtual_white": True,
    "multiple_xwaylands": True,
    "hdr": False,
    "output_connector": "*,eDP-1",
    "extra_args": "",
}

DEFAULT_PROTON = {
    "config_version": 2,
    "preset": "recommended",
    "gamemode": True,
    "mangohud": False,
    "gamescope": False,
    "use_gamescope_profile": True,
    "gamescope_width": 1920,
    "gamescope_height": 1080,
    "gamescope_refresh": 60,
    "gamescope_fullscreen": True,
    "gamescope_immediate_flips": False,
    "gamescope_hide_cursor": False,
    "gamescope_force_grab_cursor": False,
    "gamescope_adaptive_sync": False,
    "gamescope_extra_args": "",
    "enable_nvapi": False,
    "hide_nvidia_gpu": False,
    "sync_mode": "default",
    "enable_esync": True,
    "enable_fsync": True,
    "dxvk_async": False,
    "dxvk_hdr": False,
    "vkd3d_dxr": False,
    "use_wined3d": False,
    "fsr": False,
    "fsr_strength": 2,
    "custom_env": "",
    "custom_prefix": "",
}

DEFAULT_COMPATIBILITY = {
    "config_version": 1,
    "runner": "proton",
    "use_proton_profile": True,
    "gamemode": True,
    "mangohud": False,
    "gamescope": False,
    "extra_env": "",
    "extra_prefix": "",
}

PROTON_PRESETS = {
    "recommended": {
        "preset": "recommended",
        "gamemode": True,
        "mangohud": False,
        "enable_nvapi": False,
        "hide_nvidia_gpu": False,
        "sync_mode": "default",
        "dxvk_hdr": False,
        "vkd3d_dxr": False,
        "use_wined3d": False,
        "fsr": False,
    },
    "nvidia": {
        "preset": "nvidia",
        "gamemode": True,
        "enable_nvapi": True,
        "hide_nvidia_gpu": False,
        "sync_mode": "default",
        "vkd3d_dxr": False,
    },
    "hdr": {
        "preset": "hdr",
        "gamemode": True,
        "dxvk_hdr": True,
        "sync_mode": "default",
    },
    "diagnostic": {
        "preset": "diagnostic",
        "gamemode": True,
        "mangohud": True,
        "sync_mode": "default",
    },
}


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")).expanduser()


def state_home() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")).expanduser()


def gamescope_path() -> Path:
    return config_home() / "AstreaOS/gaming/gamescope.json"


def proton_path() -> Path:
    return config_home() / "AstreaOS/gaming/proton.json"


def compatibility_path() -> Path:
    return config_home() / "AstreaOS/gaming/compatibility.json"


def env_path() -> Path:
    return config_home() / "environment.d/gamescope-session-plus.conf"


def local_bin() -> Path:
    return Path.home() / ".local/bin"


def atomic_write_text(path: Path, text: str, mode: int | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        handle.write(text)
        tmp = Path(handle.name)
    if mode is not None:
        tmp.chmod(mode)
    tmp.replace(path)


def atomic_write_json(path: Path, payload: dict) -> None:
    atomic_write_text(path, json.dumps(payload, ensure_ascii=False, indent=4) + "\n")


def normalize_bool(value: object) -> bool:
    return bool(value)


def normalize_int(value: object, fallback: int, minimum: int = 0, maximum: int = 100000) -> int:
    try:
        return max(minimum, min(maximum, int(str(value).strip())))
    except (TypeError, ValueError):
        return fallback


def normalize_gamescope(data: dict) -> dict:
    cfg = {**DEFAULT_GAMESCOPE, **(data or {})}
    cfg["follow_monitor"] = normalize_bool(cfg.get("follow_monitor"))
    cfg["width"] = normalize_int(cfg.get("width"), DEFAULT_GAMESCOPE["width"], 640, 10000)
    cfg["height"] = normalize_int(cfg.get("height"), DEFAULT_GAMESCOPE["height"], 360, 10000)
    cfg["refresh"] = normalize_int(cfg.get("refresh"), DEFAULT_GAMESCOPE["refresh"], 30, 1000)
    for key in (
        "fullscreen",
        "steam_integration",
        "backend_drm",
        "immediate_flips",
        "hide_cursor",
        "fancy_scaling",
        "color_managed",
        "virtual_white",
        "multiple_xwaylands",
        "hdr",
    ):
        cfg[key] = normalize_bool(cfg.get(key))
    cfg["output_connector"] = str(cfg.get("output_connector") or DEFAULT_GAMESCOPE["output_connector"]).strip()
    cfg["extra_args"] = str(cfg.get("extra_args") or "").strip()
    return cfg


def normalize_proton(data: dict) -> dict:
    raw = data or {}
    cfg = {**DEFAULT_PROTON, **raw}
    legacy_config = int(raw.get("config_version") or 1) < 2

    if legacy_config:
        cfg["preset"] = "recommended"
        cfg["enable_nvapi"] = False
        if raw.get("enable_esync") is False and raw.get("enable_fsync") is False:
            cfg["sync_mode"] = "disable-both"
        elif raw.get("enable_esync") is False:
            cfg["sync_mode"] = "disable-esync"
        elif raw.get("enable_fsync") is False:
            cfg["sync_mode"] = "disable-fsync"
        else:
            cfg["sync_mode"] = "default"

    for key in (
        "gamemode",
        "mangohud",
        "gamescope",
        "use_gamescope_profile",
        "gamescope_fullscreen",
        "gamescope_immediate_flips",
        "gamescope_hide_cursor",
        "gamescope_force_grab_cursor",
        "gamescope_adaptive_sync",
        "enable_nvapi",
        "hide_nvidia_gpu",
        "dxvk_async",
        "dxvk_hdr",
        "vkd3d_dxr",
        "use_wined3d",
        "fsr",
    ):
        cfg[key] = normalize_bool(cfg.get(key))
    if cfg.get("preset") not in {"recommended", "nvidia", "hdr", "diagnostic", "custom"}:
        cfg["preset"] = "custom"
    if cfg.get("sync_mode") not in {"default", "disable-esync", "disable-fsync", "disable-both"}:
        cfg["sync_mode"] = "default"
    cfg["enable_esync"] = cfg["sync_mode"] not in {"disable-esync", "disable-both"}
    cfg["enable_fsync"] = cfg["sync_mode"] not in {"disable-fsync", "disable-both"}
    cfg["config_version"] = 2
    cfg["fsr_strength"] = normalize_int(cfg.get("fsr_strength"), DEFAULT_PROTON["fsr_strength"], 0, 5)
    cfg["gamescope_width"] = normalize_int(cfg.get("gamescope_width"), DEFAULT_PROTON["gamescope_width"], 640, 10000)
    cfg["gamescope_height"] = normalize_int(cfg.get("gamescope_height"), DEFAULT_PROTON["gamescope_height"], 360, 10000)
    cfg["gamescope_refresh"] = normalize_int(cfg.get("gamescope_refresh"), DEFAULT_PROTON["gamescope_refresh"], 30, 1000)
    cfg["gamescope_extra_args"] = str(cfg.get("gamescope_extra_args") or "").strip()
    cfg["custom_env"] = str(cfg.get("custom_env") or "").strip()
    cfg["custom_prefix"] = str(cfg.get("custom_prefix") or "").strip()
    return cfg


def normalize_compatibility(data: dict) -> dict:
    raw = data or {}
    cfg = {key: raw.get(key, value) for key, value in DEFAULT_COMPATIBILITY.items()}
    if cfg.get("runner") not in {"proton", "wine", "auto"}:
        cfg["runner"] = DEFAULT_COMPATIBILITY["runner"]
    for key in (
        "use_proton_profile",
        "gamemode",
        "mangohud",
        "gamescope",
    ):
        cfg[key] = normalize_bool(cfg.get(key))
    cfg["extra_env"] = str(cfg.get("extra_env") or "").strip()
    cfg["extra_prefix"] = str(cfg.get("extra_prefix") or "").strip()
    cfg["config_version"] = 1
    return cfg


def proton_preset(name: str, base: dict | None = None) -> dict:
    cfg = normalize_proton(base or {})
    preset = PROTON_PRESETS.get(name, PROTON_PRESETS["recommended"])
    cfg.update(preset)
    cfg["custom_env"] = ""
    cfg["custom_prefix"] = ""
    return normalize_proton(cfg)


def load_json(path: Path, default: dict, normalizer) -> dict:
    if not path.exists():
        cfg = normalizer(default)
        atomic_write_json(path, cfg)
        return cfg
    try:
        data = json.loads(path.read_text(encoding="utf-8") or "{}")
    except (OSError, json.JSONDecodeError):
        data = {}
    cfg = normalizer(data)
    atomic_write_json(path, cfg)
    return cfg


def run(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)


def monitors() -> list[dict]:
    if not shutil.which("hyprctl"):
        return []
    proc = run(["hyprctl", "monitors", "-j"])
    if proc.returncode != 0:
        return []
    try:
        raw = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return []
    result = []
    for monitor in raw:
        width = normalize_int(monitor.get("width"), DEFAULT_GAMESCOPE["width"], 1, 10000)
        height = normalize_int(monitor.get("height"), DEFAULT_GAMESCOPE["height"], 1, 10000)
        refresh = normalize_int(round(float(monitor.get("refreshRate") or DEFAULT_GAMESCOPE["refresh"])), DEFAULT_GAMESCOPE["refresh"], 1, 1000)
        result.append(
            {
                "name": monitor.get("name") or "",
                "description": monitor.get("description") or "",
                "width": width,
                "height": height,
                "refresh": refresh,
                "focused": bool(monitor.get("focused")),
            }
        )
    return result


def monitor_defaults() -> dict:
    found = monitors()
    if not found:
        return {
            "width": DEFAULT_GAMESCOPE["width"],
            "height": DEFAULT_GAMESCOPE["height"],
            "refresh": DEFAULT_GAMESCOPE["refresh"],
        }
    picked = next((m for m in found if m.get("focused")), found[0])
    return {
        "width": picked["width"],
        "height": picked["height"],
        "refresh": picked["refresh"],
    }


def gamescope_dimensions(cfg: dict) -> dict:
    if cfg.get("follow_monitor"):
        return monitor_defaults()
    return {
        "width": normalize_int(cfg.get("width"), DEFAULT_GAMESCOPE["width"], 640, 10000),
        "height": normalize_int(cfg.get("height"), DEFAULT_GAMESCOPE["height"], 360, 10000),
        "refresh": normalize_int(cfg.get("refresh"), DEFAULT_GAMESCOPE["refresh"], 30, 1000),
    }


def gamescope_command(cfg: dict) -> list[str]:
    dims = gamescope_dimensions(cfg)
    command = ["gamescope"]
    if cfg.get("backend_drm"):
        command += ["--backend", "drm"]
    if cfg.get("steam_integration"):
        command.append("--steam")
    if cfg.get("fullscreen"):
        command.append("--fullscreen")
    command += ["-W", str(dims["width"]), "-H", str(dims["height"]), "-r", str(dims["refresh"])]
    if cfg.get("immediate_flips"):
        command.append("--immediate-flips")
    if cfg.get("hide_cursor"):
        command += ["--hide-cursor-delay", "-1"]
    if cfg.get("extra_args"):
        command += shlex.split(cfg["extra_args"])
    command += ["--", "steam", "-gamepadui", "-steamos3", "-steamdeck"]
    return command


def gamescope_game_args(cfg: dict, mangoapp: bool = False) -> list[str]:
    cfg = normalize_gamescope(cfg)
    dims = gamescope_dimensions(cfg)
    command = ["gamescope"]
    if cfg.get("fullscreen"):
        command.append("-f")
    command += ["-W", str(dims["width"]), "-H", str(dims["height"]), "-r", str(dims["refresh"])]
    if cfg.get("immediate_flips"):
        command.append("--immediate-flips")
    if cfg.get("hide_cursor"):
        command += ["--hide-cursor-delay", "-1"]
    if mangoapp:
        command.append("--mangoapp")
    if cfg.get("extra_args"):
        command += shlex.split(cfg["extra_args"])
    command.append("--")
    return command


def proton_gamescope_config(proton_cfg: dict, shared_cfg: dict | None = None) -> dict:
    cfg = normalize_proton(proton_cfg)
    if cfg.get("use_gamescope_profile"):
        return normalize_gamescope(shared_cfg or load_json(gamescope_path(), DEFAULT_GAMESCOPE, normalize_gamescope))

    extra_args = []
    if cfg.get("gamescope_force_grab_cursor"):
        extra_args.append("--force-grab-cursor")
    if cfg.get("gamescope_adaptive_sync"):
        extra_args.append("--adaptive-sync")
    if cfg.get("gamescope_extra_args"):
        extra_args.extend(shlex.split(cfg["gamescope_extra_args"]))

    return normalize_gamescope({
        "follow_monitor": False,
        "width": cfg.get("gamescope_width"),
        "height": cfg.get("gamescope_height"),
        "refresh": cfg.get("gamescope_refresh"),
        "fullscreen": cfg.get("gamescope_fullscreen"),
        "immediate_flips": cfg.get("gamescope_immediate_flips"),
        "hide_cursor": cfg.get("gamescope_hide_cursor"),
        "extra_args": shlex.join(extra_args),
    })


def write_steam_console_launcher() -> Path:
    path = local_bin() / "steam-console-launcher"
    atomic_write_text(path, "#!/bin/bash\nexec steam -gamepadui -steamos3 -steamdeck \"$@\"\n", 0o755)
    return path


def write_gamescope_files(cfg: dict) -> dict:
    cfg = normalize_gamescope(cfg)
    dims = gamescope_dimensions(cfg)
    command = gamescope_command(cfg)
    command_text = shlex.join(command)
    steam_console = write_steam_console_launcher()

    env_lines = [
        "# Generated by Astrea Settings. Manual edits may be overwritten.",
        f"SCREEN_WIDTH={dims['width']}",
        f"SCREEN_HEIGHT={dims['height']}",
        f"SCREEN_REFRESH={dims['refresh']}",
        "__GLX_VENDOR_LIBRARY_NAME=nvidia",
        "GBM_BACKEND=nvidia-drm",
        "WLR_NO_HARDWARE_CURSORS=1",
        f"STEAM_MULTIPLE_XWAYLANDS={1 if cfg.get('multiple_xwaylands') else 0}",
        f"STEAM_GAMESCOPE_COLOR_MANAGED={1 if cfg.get('color_managed') else 0}",
        f"STEAM_GAMESCOPE_VIRTUAL_WHITE={1 if cfg.get('virtual_white') else 0}",
        f"STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT={1 if cfg.get('fancy_scaling') else 0}",
        f"STEAM_GAMESCOPE_HDR_SUPPORTED={1 if cfg.get('hdr') else 0}",
        f"GAMESCOPECMD={json.dumps(command_text)}",
        f"CLIENTCMD={json.dumps(str(steam_console))}",
        "",
    ]
    atomic_write_text(env_path(), "\n".join(env_lines))

    launcher = local_bin() / "astrea-gamescope-session"
    script = "\n".join(
        [
            "#!/bin/bash",
            "set +e",
            "export XDG_SESSION_TYPE=wayland",
            f"export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT={1 if cfg.get('fancy_scaling') else 0}",
            f"export STEAM_GAMESCOPE_COLOR_MANAGED={1 if cfg.get('color_managed') else 0}",
            f"export STEAM_GAMESCOPE_VIRTUAL_WHITE={1 if cfg.get('virtual_white') else 0}",
            f"export STEAM_MULTIPLE_XWAYLANDS={1 if cfg.get('multiple_xwaylands') else 0}",
            f"export ENABLE_GAMESCOPE_WSI={1 if cfg.get('steam_integration') else 0}",
            "sudo -n /usr/bin/systemctl start plugin_loader.service 2>/dev/null || true",
            "systemctl --user start steam-nvibrant.service 2>/dev/null || true",
            "cleanup() { sudo -n /usr/bin/systemctl stop plugin_loader.service 2>/dev/null || true; }",
            "trap cleanup HUP INT TERM",
            command_text,
            "status=$?",
            "cleanup",
            "exit $status",
            "",
        ]
    )
    atomic_write_text(launcher, script, 0o755)
    return {"command": command_text, "launcher": str(launcher), "environment": str(env_path()), "dimensions": dims}


def proton_env_and_prefix(cfg: dict, gamescope_cfg: dict | None = None) -> tuple[dict[str, str], list[str]]:
    cfg = normalize_proton(cfg)
    env: dict[str, str] = {}
    prefix: list[str] = []
    mangohud_enabled = cfg.get("mangohud")
    if cfg.get("gamemode") and shutil.which("gamemoderun"):
        prefix.append("gamemoderun")
    if cfg.get("gamescope") and shutil.which("gamescope"):
        prefix += gamescope_game_args(proton_gamescope_config(cfg, gamescope_cfg), bool(mangohud_enabled))
        mangohud_enabled = False
    if mangohud_enabled and shutil.which("mangohud"):
        prefix.append("mangohud")
    if cfg.get("enable_nvapi"):
        env["PROTON_FORCE_NVAPI"] = "1"
        env["PROTON_HIDE_NVIDIA_GPU"] = "0"
    elif cfg.get("hide_nvidia_gpu"):
        env["PROTON_HIDE_NVIDIA_GPU"] = "1"
    if cfg.get("sync_mode") in {"disable-esync", "disable-both"}:
        env["PROTON_NO_ESYNC"] = "1"
    if cfg.get("sync_mode") in {"disable-fsync", "disable-both"}:
        env["PROTON_NO_FSYNC"] = "1"
    if cfg.get("use_wined3d"):
        env["PROTON_USE_WINED3D"] = "1"
    if cfg.get("dxvk_async"):
        env["DXVK_ASYNC"] = "1"
    if cfg.get("dxvk_hdr"):
        env["DXVK_HDR"] = "1"
    if cfg.get("vkd3d_dxr"):
        env["VKD3D_CONFIG"] = "dxr"
    if cfg.get("fsr"):
        env["WINE_FULLSCREEN_FSR"] = "1"
        env["WINE_FULLSCREEN_FSR_STRENGTH"] = str(cfg.get("fsr_strength", 2))
    if cfg.get("custom_env"):
        for item in shlex.split(cfg["custom_env"]):
            if "=" in item:
                key, value = item.split("=", 1)
                if key:
                    env[key] = value
    if cfg.get("custom_prefix"):
        prefix += shlex.split(cfg["custom_prefix"])
    return env, prefix


def write_astrea_gaming_wrapper() -> Path:
    path = local_bin() / "astrea-gaming"
    config = proton_path()
    gamescope_config = gamescope_path()
    script = f"""#!/usr/bin/env python3
import json
import os
import shlex
import shutil
import sys

CONFIG = {str(config)!r}
GAMESCOPE_CONFIG = {str(gamescope_config)!r}
DEFAULT = {repr(DEFAULT_PROTON)}
DEFAULT_GAMESCOPE = {repr(DEFAULT_GAMESCOPE)}

def load_json_config(path, default):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception:
        data = {{}}
    cfg = default.copy()
    cfg.update(data or {{}})
    return cfg

def load_config():
    return load_json_config(CONFIG, DEFAULT)

def load_gamescope_config():
    return load_json_config(GAMESCOPE_CONFIG, DEFAULT_GAMESCOPE)

def int_value(value, fallback, minimum, maximum):
    try:
        return max(minimum, min(maximum, int(str(value).strip())))
    except Exception:
        return fallback

def gamescope_args(cfg, mangoapp):
    width = int_value(cfg.get("width"), DEFAULT_GAMESCOPE["width"], 640, 10000)
    height = int_value(cfg.get("height"), DEFAULT_GAMESCOPE["height"], 360, 10000)
    refresh = int_value(cfg.get("refresh"), DEFAULT_GAMESCOPE["refresh"], 30, 1000)
    args = ["gamescope"]
    if cfg.get("fullscreen"):
        args.append("-f")
    args += ["-W", str(width), "-H", str(height), "-r", str(refresh)]
    if cfg.get("immediate_flips"):
        args.append("--immediate-flips")
    if cfg.get("hide_cursor"):
        args += ["--hide-cursor-delay", "-1"]
    if mangoapp:
        args.append("--mangoapp")
    if cfg.get("extra_args"):
        args += shlex.split(str(cfg.get("extra_args") or ""))
    args.append("--")
    return args

def proton_gamescope_config(cfg, shared_cfg):
    if cfg.get("use_gamescope_profile", True):
        return shared_cfg
    extra_args = []
    if cfg.get("gamescope_force_grab_cursor"):
        extra_args.append("--force-grab-cursor")
    if cfg.get("gamescope_adaptive_sync"):
        extra_args.append("--adaptive-sync")
    if cfg.get("gamescope_extra_args"):
        extra_args += shlex.split(str(cfg.get("gamescope_extra_args") or ""))
    return {{
        "follow_monitor": False,
        "width": int_value(cfg.get("gamescope_width"), DEFAULT["gamescope_width"], 640, 10000),
        "height": int_value(cfg.get("gamescope_height"), DEFAULT["gamescope_height"], 360, 10000),
        "refresh": int_value(cfg.get("gamescope_refresh"), DEFAULT["gamescope_refresh"], 30, 1000),
        "fullscreen": bool(cfg.get("gamescope_fullscreen")),
        "immediate_flips": bool(cfg.get("gamescope_immediate_flips")),
        "hide_cursor": bool(cfg.get("gamescope_hide_cursor")),
        "extra_args": shlex.join(extra_args),
    }}

def main():
    command = sys.argv[1:]
    if not command:
        print("Usage: astrea-gaming %command%", file=sys.stderr)
        return 2
    cfg = load_config()
    gamescope_cfg = proton_gamescope_config(cfg, load_gamescope_config())
    env = os.environ.copy()
    prefix = []
    mangohud_enabled = cfg.get("mangohud")
    if cfg.get("gamemode") and shutil.which("gamemoderun"):
        prefix.append("gamemoderun")
    if cfg.get("gamescope") and shutil.which("gamescope"):
        prefix += gamescope_args(gamescope_cfg, bool(mangohud_enabled))
        mangohud_enabled = False
    if mangohud_enabled and shutil.which("mangohud"):
        prefix.append("mangohud")
    if cfg.get("enable_nvapi"):
        env["PROTON_FORCE_NVAPI"] = "1"
        env["PROTON_HIDE_NVIDIA_GPU"] = "0"
    elif cfg.get("hide_nvidia_gpu"):
        env["PROTON_HIDE_NVIDIA_GPU"] = "1"
    if cfg.get("sync_mode") in ("disable-esync", "disable-both"):
        env["PROTON_NO_ESYNC"] = "1"
    if cfg.get("sync_mode") in ("disable-fsync", "disable-both"):
        env["PROTON_NO_FSYNC"] = "1"
    if cfg.get("use_wined3d"):
        env["PROTON_USE_WINED3D"] = "1"
    if cfg.get("dxvk_async"):
        env["DXVK_ASYNC"] = "1"
    if cfg.get("dxvk_hdr"):
        env["DXVK_HDR"] = "1"
    if cfg.get("vkd3d_dxr"):
        env["VKD3D_CONFIG"] = "dxr"
    if cfg.get("fsr"):
        env["WINE_FULLSCREEN_FSR"] = "1"
        env["WINE_FULLSCREEN_FSR_STRENGTH"] = str(cfg.get("fsr_strength", 2))
    for item in shlex.split(str(cfg.get("custom_env") or "")):
        if "=" in item:
            key, value = item.split("=", 1)
            if key:
                env[key] = value
    prefix += shlex.split(str(cfg.get("custom_prefix") or ""))
    final = prefix + command
    os.execvpe(final[0], final, env)

if __name__ == "__main__":
    raise SystemExit(main())
"""
    atomic_write_text(path, script, 0o755)
    return path


def command_preview(proton_cfg: dict) -> str:
    return "astrea-gaming %command%"


def proton_status(proton: dict, wrapper: Path, gamescope: dict | None = None) -> dict:
    env, prefix = proton_env_and_prefix(proton, gamescope)
    return {
        "proton_command": "astrea-gaming %command%",
        "proton_preview": command_preview(proton),
        "proton_wrapper": str(wrapper),
        "proton_env": env,
        "proton_prefix": prefix,
        "proton_preset": proton.get("preset", "recommended"),
    }


def payload() -> dict:
    gamescope = load_json(gamescope_path(), DEFAULT_GAMESCOPE, normalize_gamescope)
    proton = load_json(proton_path(), DEFAULT_PROTON, normalize_proton)
    compatibility = load_json(compatibility_path(), DEFAULT_COMPATIBILITY, normalize_compatibility)
    gamescope_files = write_gamescope_files(gamescope)
    wrapper = write_astrea_gaming_wrapper()
    proton_state = proton_status(proton, wrapper, gamescope)
    return {
        "gamescope": gamescope,
        "proton": proton,
        "compatibility": compatibility,
        "status": {
            "monitors": monitors(),
            "gamescope_command": gamescope_files["command"],
            "gamescope_launcher": gamescope_files["launcher"],
            "environment_file": gamescope_files["environment"],
            **proton_state,
        },
    }


def save_gamescope(json_data: str, apply_files: bool = True) -> dict:
    cfg = normalize_gamescope(json.loads(json_data or "{}"))
    atomic_write_json(gamescope_path(), cfg)
    result = {"ok": True, "gamescope": cfg}
    if apply_files:
        result["status"] = write_gamescope_files(cfg)
    return result


def save_proton(json_data: str, apply_files: bool = True) -> dict:
    cfg = normalize_proton(json.loads(json_data or "{}"))
    atomic_write_json(proton_path(), cfg)
    result = {"ok": True, "proton": cfg}
    if apply_files:
        wrapper = write_astrea_gaming_wrapper()
        gamescope = load_json(gamescope_path(), DEFAULT_GAMESCOPE, normalize_gamescope)
        proton_state = proton_status(cfg, wrapper, gamescope)
        result["status"] = {
            "wrapper": proton_state["proton_wrapper"],
            "command": proton_state["proton_command"],
            "preview": proton_state["proton_preview"],
            "env": proton_state["proton_env"],
            "prefix": proton_state["proton_prefix"],
            "preset": proton_state["proton_preset"],
            **proton_state,
        }
    return result


def save_compatibility(json_data: str) -> dict:
    cfg = normalize_compatibility(json.loads(json_data or "{}"))
    atomic_write_json(compatibility_path(), cfg)
    return {"ok": True, "compatibility": cfg}


def main() -> int:
    parser = argparse.ArgumentParser(description="Astrea gaming settings helper")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("get")
    save_g = sub.add_parser("save-gamescope")
    save_g.add_argument("json_data")
    save_p = sub.add_parser("save-proton")
    save_p.add_argument("json_data")
    save_c = sub.add_parser("save-compatibility")
    save_c.add_argument("json_data")
    sub.add_parser("apply")
    args = parser.parse_args()

    if args.command == "get":
        print(json.dumps(payload(), ensure_ascii=False))
        return 0
    if args.command == "save-gamescope":
        print(json.dumps(save_gamescope(args.json_data), ensure_ascii=False))
        return 0
    if args.command == "save-proton":
        print(json.dumps(save_proton(args.json_data), ensure_ascii=False))
        return 0
    if args.command == "save-compatibility":
        print(json.dumps(save_compatibility(args.json_data), ensure_ascii=False))
        return 0
    if args.command == "apply":
        gamescope = load_json(gamescope_path(), DEFAULT_GAMESCOPE, normalize_gamescope)
        proton = load_json(proton_path(), DEFAULT_PROTON, normalize_proton)
        write_gamescope_files(gamescope)
        write_astrea_gaming_wrapper()
        print(json.dumps({"ok": True, "proton_preview": command_preview(proton)}, ensure_ascii=False))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
