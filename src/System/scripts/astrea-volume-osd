#!/usr/bin/env bash
set -u

sink='@DEFAULT_AUDIO_SINK@'
qs_path="${ASTREA_QUICKSHELL_PATH:-$HOME/.local/share/Astrea/Quickshell}"
action="${1:-show}"
changed_volume=false

case "$action" in
    up)
        wpctl set-volume -l 1 "$sink" "${2:-5%+}" || exit 1
        changed_volume=true
        ;;
    down)
        wpctl set-volume "$sink" "${2:-5%-}" || exit 1
        changed_volume=true
        ;;
    mute)
        wpctl set-mute "$sink" toggle || exit 1
        changed_volume=true
        ;;
    show)
        ;;
    *)
        printf 'usage: %s [up|down|mute|show]\n' "$0" >&2
        exit 2
        ;;
esac

if [ "$changed_volume" = true ] && systemctl --user is-active --quiet astrea-status.service; then
    exit 0
fi

status="$(wpctl get-volume "$sink" 2>/dev/null || true)"
muted=false
case "$status" in
    *MUTED*) muted=true ;;
esac

level=0
volume_token=""
for field in $status; do
    if [[ "$field" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        volume_token="$field"
        break
    fi
done

if [ -n "$volume_token" ]; then
    whole="${volume_token%%.*}"
    frac=""
    if [[ "$volume_token" == *.* ]]; then
        frac="${volume_token#*.}"
    fi
    frac="${frac}000"
    frac2="${frac:0:2}"
    frac3="${frac:2:1}"
    level=$((10#$whole * 100 + 10#$frac2))
    if [ "$frac3" -ge 5 ]; then
        level=$((level + 1))
    fi
fi

qs ipc call astrea-osd showVolume "$level" "$muted" >/dev/null 2>&1 \
    || quickshell ipc call astrea-osd showVolume "$level" "$muted" >/dev/null 2>&1 \
    || qs -p "$qs_path" ipc call astrea-osd showVolume "$level" "$muted" >/dev/null 2>&1 \
    || quickshell -p "$qs_path" ipc call astrea-osd showVolume "$level" "$muted" >/dev/null 2>&1 \
    || true
