def config_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")).expanduser()
    return base / "AstreaOS/system/performance.json"


def atomic_write(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=4)
        handle.write("\n")
        tmp = Path(handle.name)
    tmp.replace(path)


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        cfg = normalize_config(DEFAULT_CONFIG)
        atomic_write(path, cfg)
        return cfg
    try:
        data = json.loads(path.read_text(encoding="utf-8") or "{}")
    except (OSError, json.JSONDecodeError):
        data = {}
    cfg = normalize_config(data)
    atomic_write(path, cfg)
    return cfg


def normalize_config(data: dict) -> dict:
    cfg = {**DEFAULT_CONFIG, **(data or {})}
    if cfg.get("profile") not in {"power-saver", "balanced", "performance"}:
        cfg["profile"] = DEFAULT_CONFIG["profile"]
    if cfg.get("scx_scheduler") not in {item["id"] for item in SCX_CATALOG}:
        cfg["scx_scheduler"] = DEFAULT_CONFIG["scx_scheduler"]
    if cfg.get("scx_mode") not in {item["id"] for item in SCX_MODES}:
        cfg["scx_mode"] = DEFAULT_CONFIG["scx_mode"]
    for key in (
        "auto_apply",
        "prefer_gamemode",
        "launch_boost",
        "reduce_effects",
        "limit_background_tasks",
        "show_status_badges",
    ):
        cfg[key] = bool(cfg.get(key))
    cfg["auto_apply"] = True
    return cfg


def command_available(name: str) -> bool:
    return shutil.which(name) is not None


def run(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
    )


def scheduler_catalog() -> list[dict]:
    return [dict(item) for item in SCX_CATALOG]


def scheduler_modes() -> list[dict]:
    return [dict(item) for item in SCX_MODES]


def parse_scxctl_get(output: str) -> dict:
    text = (output or "").strip()
    result = {
        "active": False,
        "scheduler": "",
        "scheduler_label": "",
        "mode": "",
        "mode_label": "",
        "raw": text,
    }
    match = re.search(r"running\s+([A-Za-z0-9_-]+)\s+in\s+(.+?)\s+mode", text, re.IGNORECASE)
    if not match:
        return result
    scheduler_label = match.group(1).strip()
    mode_label = match.group(2).strip()
    result.update(
        {
            "active": True,
            "scheduler": scheduler_label.lower(),
            "scheduler_label": scheduler_label,
            "mode": re.sub(r"[^a-z0-9]+", "", mode_label.lower()),
            "mode_label": mode_label,
        }
    )
    return result


def parse_scxctl_list(output: str) -> list[str]:
    text = (output or "").strip()
    if not text:
        return []
    _, _, tail = text.partition(":")
    raw = tail.strip() if tail else text
    try:
        parsed = ast.literal_eval(raw)
    except (SyntaxError, ValueError):
        parsed = []
    if not isinstance(parsed, list):
        return []
    return [str(item).lower() for item in parsed if str(item).strip()]


def available_scx_binaries() -> list[str]:
    found = []
    for item in SCX_CATALOG:
        if command_available(f"scx_{item['id']}"):
            found.append(item["id"])
    return found


def scx_status() -> dict:
    has_scxctl = command_available("scxctl")
    supported = available_scx_binaries()
    current = {
        "active": False,
        "scheduler": "",
        "scheduler_label": "",
        "mode": "",
        "mode_label": "",
        "raw": "",
    }
    error = ""

    if has_scxctl:
        proc = run(["scxctl", "get"])
        if proc.returncode == 0:
            current = parse_scxctl_get(proc.stdout)
        else:
            error = (proc.stderr or proc.stdout or "").strip()

        list_proc = run(["scxctl", "list"])
        if list_proc.returncode == 0:
            listed = parse_scxctl_list(list_proc.stdout)
            if listed:
                supported = listed

    service_state = "unknown"
    if command_available("systemctl"):
        service_proc = run(["systemctl", "is-active", "scx_loader.service"])
        service_state = (service_proc.stdout or service_proc.stderr or "unknown").strip()

    return {
        "scxctl": has_scxctl,
        "service": service_state,
        "current": current,
        "supported": supported,
        "catalog": scheduler_catalog(),
        "modes": scheduler_modes(),
        "error": error,
    }


def status() -> dict:
    profile = "unknown"
    has_ppd = command_available("powerprofilesctl")
    if has_ppd:
        proc = run(["powerprofilesctl", "get"])
        if proc.returncode == 0 and proc.stdout.strip():
            profile = proc.stdout.strip()
    has_gamemode = command_available("gamemoded")
    gamemode_active = False
    if has_gamemode:
        gamemode_active = run(["gamemoded", "-s"]).returncode == 0
    return {
        "powerprofilesctl": has_ppd,
        "gamemode": has_gamemode,
        "gamemode_active": gamemode_active,
        "profile": profile,
        "scx": scx_status(),
    }


def set_scheduler(scheduler: str, mode: str) -> int:
    scheduler = scheduler.strip().lower()
    mode = mode.strip().lower()
    if scheduler not in {item["id"] for item in SCX_CATALOG}:
        print(f"Unsupported scheduler: {scheduler}", file=__import__("sys").stderr)
        return 2
    if mode not in {item["id"] for item in SCX_MODES}:
        print(f"Unsupported scheduler mode: {mode}", file=__import__("sys").stderr)
        return 2

    config = load_config()
    config["scx_scheduler"] = scheduler
    config["scx_mode"] = mode
    atomic_write(config_path(), config)

    if not command_available("scxctl"):
        print(json.dumps({"ok": False, "error": "scxctl not installed"}, ensure_ascii=False))
        return 1

    proc = run(["scxctl", "switch", "--sched", scheduler, "--mode", mode])
    if proc.returncode != 0:
        print((proc.stderr or proc.stdout or "scxctl failed").strip(), file=__import__("sys").stderr)
        return proc.returncode

    print(json.dumps({"ok": True, "scheduler": scheduler, "mode": mode}, ensure_ascii=False))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Astrea performance settings helper")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("get")
    sub.add_parser("status")
    set_parser = sub.add_parser("set")
    set_parser.add_argument(
        "profile", choices=["power-saver", "balanced", "performance"]
    )
    set_scheduler_parser = sub.add_parser("set-scheduler")
    set_scheduler_parser.add_argument("scheduler", choices=[item["id"] for item in SCX_CATALOG])
    set_scheduler_parser.add_argument("mode", choices=[item["id"] for item in SCX_MODES])
    save_parser = sub.add_parser("save")
    save_parser.add_argument("json_data")
    args = parser.parse_args()

    if args.command == "get":
        print(json.dumps(load_config(), ensure_ascii=False))
        return 0
    if args.command == "status":
        print(json.dumps(status(), ensure_ascii=False))
        return 0
    if args.command == "set":
        config = load_config()
        config["profile"] = args.profile
        atomic_write(config_path(), config)
        if command_available("powerprofilesctl"):
            proc = run(["powerprofilesctl", "set", args.profile])
            if proc.returncode != 0:
                print(
                    (proc.stderr or proc.stdout or "powerprofilesctl failed").strip(),
                    file=__import__("sys").stderr,
                )
                return proc.returncode
        print(json.dumps({"ok": True, "profile": args.profile}, ensure_ascii=False))
        return 0
    if args.command == "set-scheduler":
        return set_scheduler(args.scheduler, args.mode)
    if args.command == "save":
        config = normalize_config(json.loads(args.json_data))
        atomic_write(config_path(), config)
        print(json.dumps({"ok": True}, ensure_ascii=False))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
