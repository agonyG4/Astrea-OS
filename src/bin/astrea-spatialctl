              "Gain 1" = {float(data["front"])}
              "Gain 2" = {float(data["side"])}
              "Gain 3" = {float(data["rear"])}
              "Gain 4" = {float(data["center"])}
              "Gain 5" = {float(data["front"])}
              "Gain 6" = {float(data["side"])}
              "Gain 7" = {float(data["rear"])}
              "Gain 8" = {float(data["lfe"])}
            }}
          }}

          {{ type = builtin label = bq_peaking   name = warmth_L control = {{ "Freq" = 180.0   "Q" = 0.90 "Gain" = {float(data["warmth"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq1k_L    control = {{ "Freq" = 1000.0  "Q" = 0.90 "Gain" = {float(data["mids_1k"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq2k_L    control = {{ "Freq" = 2200.0  "Q" = 1.00 "Gain" = {float(data["presence_2k"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq7k_L    control = {{ "Freq" = 7000.0  "Q" = 1.40 "Gain" = {float(data["treble_7k"])} }} }}
          {{ type = builtin label = bq_highshelf name = air_L     control = {{ "Freq" = 10000.0 "Q" = 0.70 "Gain" = {float(data["air_10k"])} }} }}

          {{ type = builtin label = bq_peaking   name = warmth_R control = {{ "Freq" = 180.0   "Q" = 0.90 "Gain" = {float(data["warmth"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq1k_R    control = {{ "Freq" = 1000.0  "Q" = 0.90 "Gain" = {float(data["mids_1k"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq2k_R    control = {{ "Freq" = 2200.0  "Q" = 1.00 "Gain" = {float(data["presence_2k"])} }} }}
          {{ type = builtin label = bq_peaking   name = eq7k_R    control = {{ "Freq" = 7000.0  "Q" = 1.40 "Gain" = {float(data["treble_7k"])} }} }}
