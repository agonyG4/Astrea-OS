#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional

CONFIG = Path.home() / ".config/astrea/spatial-live.json"
PIPEWIRE_CONF = Path.home() / ".config/pipewire/pipewire.conf.d/sink-virtual-surround-7.1-hesuvi-surroundeq.conf"
DEFAULT_HRIR = Path.home() / ".config/pipewire/hrir_hesuvi/hrir.wav"
DEFAULT_NODE_NAME = "effect_input.surroundeq"

DEFAULT: Dict[str, float | bool | str] = {
    "enabled": True,
    "node_name": DEFAULT_NODE_NAME,
    "hrir": str(DEFAULT_HRIR),

    "front": 0.98,
    "center": 1.05,
    "side": 0.58,
    "rear": 0.58,
    "lfe": 0.50,

    "bass": -1.0,
    "mud": 0.0,
    "box": -2.0,
    "presence": 1.5,
    "harsh": -2.0,
    "air": -1.0,

    "wet": 1.0,
    "dry_front": 0.0,
    "dry_center": 0.0,
}

def run(cmd: List[str], *, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)

def load() -> Dict[str, Any]:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    if not CONFIG.exists():
        save(dict(DEFAULT))
    try:
        with CONFIG.open() as f:
            data = json.load(f)
    except Exception:
        data = {}
    merged = dict(DEFAULT)
    merged.update(data)
    if merged.get("node_name") == "effect_input.astrea-spatial":
        merged["node_name"] = DEFAULT_NODE_NAME
    return merged

def save(data: Dict[str, Any]) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    with CONFIG.open("w") as f:
        json.dump(data, f, indent=2)

def find_node_id(node_name: str) -> Optional[int]:
    try:
        cp = run(["pw-dump", node_name], check=True)
        graph = json.loads(cp.stdout)
        if graph:
            return int(graph[0]["id"])
    except Exception:
        pass

    try:
        cp = run(["pw-dump"], check=True)
        graph = json.loads(cp.stdout)
    except Exception as e:
        print(f"failed to read pw-dump: {e}", file=sys.stderr)
        return None

    for obj in graph:
        props = obj.get("info", {}).get("props", {})
        if props.get("node.name") == node_name:
            try:
                return int(obj["id"])
            except Exception:
                return None
    return None

def get_control_params(node_id: int) -> Dict[str, float]:
    try:
        cp = run(["pw-dump", str(node_id)], check=True)
        data = json.loads(cp.stdout)
    except Exception:
        return {}

    params_list = []
    for obj in data:
        props_entries = obj.get("info", {}).get("params", {}).get("Props", [])
        for entry in props_entries:
            arr = entry.get("params")
            if isinstance(arr, list):
                params_list.extend(arr)

    out: Dict[str, float] = {}
    i = 0
    while i < len(params_list) - 1:
        key = params_list[i]
        val = params_list[i + 1]
        if isinstance(key, str) and isinstance(val, (int, float)):
            out[key] = float(val)
        i += 2
    return out

def set_params_live(node_id: int, pairs: Dict[str, float]) -> None:
    payload: List[Any] = []
    for key, value in pairs.items():
        payload.extend([key, float(value)])

    param_json = json.dumps({"params": payload})
    cp = run(["pw-cli", "s", str(node_id), "Props", param_json], check=False)
    if cp.returncode != 0:
        raise RuntimeError(cp.stderr.strip() or cp.stdout.strip() or "pw-cli set-param failed")

def controls_for_key(key: str, value: float) -> Dict[str, float]:
    # Mixer inputs:
    # 1 FL, 2 SL, 3 RL, 4 FC, 5 FR, 6 SR, 7 RR, 8 LFE
    if key == "front":
        return {
            "mixL:Gain 1": value, "mixR:Gain 1": value,
            "mixL:Gain 5": value, "mixR:Gain 5": value,
        }
    if key == "center":
        return {"mixL:Gain 4": value, "mixR:Gain 4": value}
    if key == "side":
        return {
            "mixL:Gain 2": value, "mixR:Gain 2": value,
            "mixL:Gain 6": value, "mixR:Gain 6": value,
        }
    if key == "rear":
        return {
            "mixL:Gain 3": value, "mixR:Gain 3": value,
            "mixL:Gain 7": value, "mixR:Gain 7": value,
        }
    if key == "lfe":
        return {"mixL:Gain 8": value, "mixR:Gain 8": value}

    if key == "bass":
        return {"eq_bass_L:Gain": value, "eq_bass_R:Gain": value}
    if key == "mud" or key == "warmth":
        return {"eq_mud_L:Gain": value, "eq_mud_R:Gain": value}
    if key == "box" or key == "mids_1k":
        return {"eq_box_L:Gain": value, "eq_box_R:Gain": value}
    if key == "presence" or key == "presence_2k":
        return {"eq_presence_L:Gain": value, "eq_presence_R:Gain": value}
    if key == "harsh" or key == "treble_7k":
        return {"eq_harsh_L:Gain": value, "eq_harsh_R:Gain": value}
    if key == "air" or key == "air_10k":
        return {"eq_air_L:Gain": value, "eq_air_R:Gain": value}

    if key == "wet":
        return {"finalL:Gain 1": value, "finalR:Gain 1": value}
    if key == "dry_front":
        return {"finalL:Gain 2": value, "finalR:Gain 2": value}
    if key == "dry_center":
        return {"finalL:Gain 3": value, "finalR:Gain 3": value}

    raise KeyError(key)

def all_live_pairs(data: Dict[str, Any]) -> Dict[str, float]:
    keys = [
        "front", "center", "side", "rear", "lfe",
        "bass", "mud", "box", "presence", "harsh", "air",
        "wet", "dry_front", "dry_center",
    ]
    pairs: Dict[str, float] = {}
    for key in keys:
        pairs.update(controls_for_key(key, float(data[key])))
    return pairs

def generate_filter_chain(data: Dict[str, Any]) -> str:
    hrir = str(data["hrir"])
    node_name = str(data["node_name"])
    return f'''
