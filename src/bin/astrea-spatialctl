def install_config(restart_pipewire: bool = True) -> None:
    data = load()
    PIPEWIRE_CONF.parent.mkdir(parents=True, exist_ok=True)
    PIPEWIRE_CONF.write_text(generate_filter_chain(data))

    if restart_pipewire:
        cp = subprocess.run(["systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber"])
        if cp.returncode != 0:
            print("warning: failed to restart PipeWire services", file=sys.stderr)

def set_key_live(key: str, value: float, *, no_save: bool = False) -> None:
    data = load()
    if key not in DEFAULT:
        raise SystemExit(f"unknown key: {key}")

    data[key] = value
    if not no_save:
        save(data)

    node_id = find_node_id(str(data["node_name"]))
    if node_id is None:
        raise SystemExit(f"node not found: {data['node_name']}. Run: astrea-spatialctl install")

    pairs = controls_for_key(key, value)
    set_params_live(node_id, pairs)

def sync_live() -> None:
    data = load()
    node_id = find_node_id(str(data["node_name"]))
    if node_id is None:
        raise SystemExit(f"node not found: {data['node_name']}. Run: astrea-spatialctl install")
    set_params_live(node_id, all_live_pairs(data))

def main() -> None:
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("get")
    sub.add_parser("status")
    sub.add_parser("install")
    sub.add_parser("sync")
    sub.add_parser("controls")

    sp = sub.add_parser("set")
    sp.add_argument("key")
    sp.add_argument("value", type=float)
    sp.add_argument("--no-save", action="store_true")

    sp = sub.add_parser("set-hrir")
    sp.add_argument("path")

    sp = sub.add_parser("preset")
    sp.add_argument("name", choices=["pure", "daily", "close", "extreme", "reset"])

    args = p.parse_args()

    if args.cmd == "get":
        print(json.dumps(load(), indent=2))
        return

    if args.cmd == "status":
        data = load()
        node_id = find_node_id(str(data["node_name"]))
        print(json.dumps({
            "node_name": data["node_name"],
            "node_id": node_id,
            "config": str(CONFIG),
            "pipewire_conf": str(PIPEWIRE_CONF),
            "hrir": data["hrir"],
            "live": node_id is not None
        }, indent=2))
        return

    if args.cmd == "install":
        if not PIPEWIRE_CONF.exists():
            install_config(restart_pipewire=True)
            print("installed. this restarts PipeWire once. slider changes after this are live.")
            return
        print(f"using existing PipeWire filter-chain: {PIPEWIRE_CONF}")
        return

    if args.cmd == "sync":
        sync_live()
        print("synced live")
        return

    if args.cmd == "controls":
        data = load()
        node_id = find_node_id(str(data["node_name"]))
        if node_id is None:
            raise SystemExit("node not found")
        controls = get_control_params(node_id)
        for k in sorted(controls):
            print(f"{k} = {controls[k]}")
        return

    if args.cmd == "set":
        set_key_live(args.key, args.value, no_save=args.no_save)
        print(f"{args.key}={args.value}")
        return

    if args.cmd == "set-hrir":
        data = load()
        data["hrir"] = str(Path(args.path).expanduser())
        save(data)
        install_config(restart_pipewire=True)
        print("HRIR changed. PipeWire restarted once because convolver filename cannot be hot-swapped reliably.")
        return

    if args.cmd == "preset":
        data = load()
        if args.name == "reset":
            data = dict(DEFAULT)
        elif args.name == "pure":
            data.update({
                "front": 0.98, "center": 1.05, "side": 0.58, "rear": 0.58, "lfe": 0.50,
                "bass": -1.0, "mud": 0.0, "box": -2.0, "presence": 1.5, "harsh": -2.0, "air": -1.0,
                "wet": 1.0, "dry_front": 0.0, "dry_center": 0.0,
            })
        elif args.name == "daily":
            data.update({
                "front": 1.0, "center": 1.02, "side": 0.65, "rear": 0.65, "lfe": 0.40,
                "bass": -0.5, "mud": 0.0, "box": -1.8, "presence": 1.2, "harsh": -2.2, "air": -0.8,
                "wet": 1.0, "dry_front": 0.0, "dry_center": 0.0,
            })
        elif args.name == "close":
            data.update({
                "front": 1.0, "center": 1.05, "side": 0.50, "rear": 0.50, "lfe": 0.35,
                "bass": -0.5, "mud": 0.0, "box": -2.2, "presence": 0.8, "harsh": -2.6, "air": -1.0,
                "wet": 0.94, "dry_front": 0.02, "dry_center": 0.04,
            })
        elif args.name == "extreme":
            data.update({
                "front": 1.18, "center": 1.30, "side": 1.35, "rear": 1.35, "lfe": 0.85,
                "bass": 6.0, "mud": -3.0, "box": -6.0, "presence": 5.0, "harsh": -6.0, "air": 4.0,
                "wet": 1.25, "dry_front": 0.08, "dry_center": 0.10,
            })
        save(data)
        sync_live()
        print(json.dumps(data, indent=2))
        return

if __name__ == "__main__":
    main()
